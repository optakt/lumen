    intervention: "A reliability audit changes only local confidence of x0034s2 from 0.75 to 0.25. Propagate through the declared graph, then recompute from the prior."
    belief: [0.573055, 0.814969]
    state: active
    accepted_support: ["x0034s1","x0034s2","x0034s3","x0034s4"]
    rejected_support: []
