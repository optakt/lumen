// Causal retraction cascade — variant A.
episode cascade-a
  family: retraction-cascade
  variant: a
  claim: "The Aster relay should enter conservation mode."
  world: "The derivation graph is: record r1 derives belief b1; r1 and independent record r2 derive belief b2; b1 and b2 derive focal belief b3; independent record r3 derives unrelated belief b4. Retraction propagates only through derivation edges. A dependent belief becomes suspect, not false, when any derivation ancestor is retracted."
  prior: [0.7800, 0.8600]
  step graph-loaded
    role: graph-loaded
    intervention: "Records r1, r2, and r3 are valid. Beliefs b1, b2, b3, and b4 are active. Report the focal belief b3 and every belief-node state."
    belief: [0.7800, 0.8600]
    state: active
    accepted_support: ["r1", "r2"]
    rejected_support: []
    node_states: {"b1":"active","b2":"active","b3":"active","b4":"active"}
    action: hold
  step source-retracted
    role: retracted
    intervention: "Record r1 is retracted because its measurement file was corrupted. Apply the causal cascade. Do not equate suspect with false."
    belief: [0.7800, 0.8600]
    state: suspect
    accepted_support: ["r2"]
    rejected_support: ["r1"]
    node_states: {"b1":"suspect","b2":"suspect","b3":"suspect","b4":"active"}
    action: contract
  step unrelated-record
    role: isolation
    intervention: "A new record r5 states that an unrelated Cinder relay changed color. It has no edge to b1, b2, b3, or b4."
    belief: [0.7800, 0.8600]
    state: suspect
    accepted_support: ["r2"]
    rejected_support: ["r1"]
    node_states: {"b1":"suspect","b2":"suspect","b3":"suspect","b4":"active"}
    action: hold
